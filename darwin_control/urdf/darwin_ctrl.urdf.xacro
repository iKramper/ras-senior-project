<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="darwin">

    <xacro:include filename="$(find darwin_gazebo)/urdf/darwin_gz.urdf.xacro"/>
    <xacro:arg name="controller" default="ros_controller"/>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- HEAD -->
        <joint name="neck_joint">
            <command_interface name="position">
                <param name="min">0.878</param>
                <param name="max">3.963</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.1</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- LEFT ARM -->
        <joint name="l_shoulder_joint">
            <command_interface name="position">
                <param name="min">1.047</param>
                <param name="max">4.132</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.1</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_biceps_joint">
            <command_interface name="position">
                <param name="min">3.200</param>
                <param name="max">5.038</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">3.4</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_elbow_joint">
            <command_interface name="position">
                <param name="min">1.302</param>
                <param name="max">4.274</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.4</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- RIGHT ARM -->
        <joint name="r_shoulder_joint">
            <command_interface name="position">
                <param name="min">1.189</param>
                <param name="max">4.161</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.2</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_biceps_joint">
            <command_interface name="position">
                <param name="min">0.312</param>
                <param name="max">1.840</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_elbow_joint">
            <command_interface name="position">
                <param name="min">1.075</param>
                <param name="max">3.764</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.2</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- LEFT LEG -->
        <joint name="l_hip_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">0.115</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_thigh_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">0.200</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_knee_joint">
            <command_interface name="position">
                <param name="min">0.991</param>
                <param name="max">3.142</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_ankle_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">0.453</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="l_foot_joint">
            <command_interface name="position">
                <param name="min">3.764</param>
                <param name="max">5.236</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">3.9</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- RIGHT LEG -->
        <joint name="r_hip_joint">
            <command_interface name="position">
                <param name="min">5.000</param>
                <param name="max">5.236</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">5.1</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_thigh_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">1.019</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_knee_joint">
            <command_interface name="position">
                <param name="min">0.793</param>
                <param name="max">2.434</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.9</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_ankle_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">0.500</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="r_foot_joint">
            <command_interface name="position">
                <param name="min">0.000</param>
                <param name="max">1.132</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find darwin_control)/config/darwin_controller_manager.yaml</parameters>
        </plugin>
    </gazebo>


</robot>