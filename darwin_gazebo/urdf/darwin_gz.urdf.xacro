<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="darwin">

    <xacro:include filename="$(find darwin_description)/urdf/darwin.urdf.xacro"/>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>

            <joint_name>neck_joint</joint_name>

            <joint_name>l_shoulder_joint</joint_name>
            <joint_name>l_biceps_joint</joint_name>
            <joint_name>l_elbow_joint</joint_name>

            <joint_name>r_shoulder_joint</joint_name>
            <joint_name>r_biceps_joint</joint_name>
            <joint_name>r_elbow_joint</joint_name>

            <joint_name>l_hip_joint</joint_name>
            <joint_name>l_thigh_joint</joint_name>
            <joint_name>l_knee_joint</joint_name>
            <joint_name>l_ankle_joint</joint_name>
            <joint_name>l_foot_joint</joint_name>

            <joint_name>r_hip_joint</joint_name>
            <joint_name>r_thigh_joint</joint_name>
            <joint_name>r_knee_joint</joint_name>
            <joint_name>r_ankle_joint</joint_name>
            <joint_name>r_foot_joint</joint_name>
        </plugin>
    </gazebo>

</robot>